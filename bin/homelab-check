#!/usr/bin/env bash
# Checks run by Monit (modules/13-monit.sh). Exit 0 = fine, 1 = problem; the
# output becomes the notification text, so it is written as a sentence for
# whoever reads it on a phone, in both states: a recovery shows the OK text.
set -euo pipefail
DATA_DIR=/data

# docker.socket accepts a connection even when docker.service cannot start
# (02-data.sh's drop-in blocks it without /data), and the client then waits
# forever: Monit killed this script each cycle and orphaned a ~28MB client,
# 178 of them in 15 hours until the Pi was in swap. A wedged daemon does the
# same with /data present, so bound the call rather than test for that case.
docker() { timeout 15 docker "$@"; }

case "${1:-}" in
data)
    # A read-only /data makes containers crash-loop, and every container start
    # leaks a little kernel memory: ~6000 restarts once added up to ~570MB and
    # got the Pi OOM-killed for days. Stopping Docker ends the loop; the
    # drop-in from 02-data.sh keeps it from starting again until /data is
    # read-write.
    if findmnt -O rw "$DATA_DIR" >/dev/null; then
        echo "$DATA_DIR is mounted and writable."
        exit 0
    fi
    if systemctl is-active -q docker.socket || systemctl is-active -q docker.service; then
        systemctl stop docker.socket docker.service
        echo "$DATA_DIR is not writable, so Docker was stopped to keep the containers from crash-looping. Repair it with fsck and remount it, then: systemctl start docker"
    else
        echo "$DATA_DIR is not writable, and Docker is already stopped."
    fi
    exit 1
    ;;
restarts)
    # unless-stopped retries forever. Five starts of one container within ten
    # minutes is a crash loop: stop it. A manual stop also sticks across
    # reboots, so it stays down until someone looks.
    looping=$(journalctl _PID=1 --since -10min -o cat \
        | { grep -oP '^Started docker-\K[0-9a-f]{64}(?=\.scope)' || true; } \
        | sort | uniq -c | awk '$1 >= 5 { print $2 }')
    found=0
    for id in $looping; do
        # Gone already (removed by hand): nothing left to stop.
        name=$(docker inspect -f '{{.Name}}' "$id" 2>/dev/null) || continue
        docker stop "$id" >/dev/null
        echo "${name#/} restarted 5 times in 10 minutes, so it was stopped. Start it again by hand once it is fixed."
        found=1
    done
    (( found )) || echo "No container is crash-looping."
    (( ! found ))
    ;;
kmem)
    # Unreclaimable kernel memory, hidden inside "used" everywhere else.
    # ~135MB here with every service up; the crash-loop leak above is what
    # drives it up, and it reached ~570MB on the Pi.
    kb=$(awk '/^SUnreclaim:/ { print $2 }' /proc/meminfo)
    if (( kb < 400 * 1024 )); then
        echo "Unreclaimable kernel memory is at $(( kb / 1024 )) MB."
        exit 0
    fi
    echo "Unreclaimable kernel memory is at $(( kb / 1024 )) MB (alert above 400 MB). A crash-looping container is the usual cause."
    exit 1
    ;;
temp)
    # The CPU package sensor, found by type: zone numbers are not stable, and
    # thermal_zone0 is the chipset here. The i3-7100 throttles at 100°C and
    # sat at 70°C with one thread busy in this small case.
    zone=$(grep -lx x86_pkg_temp /sys/class/thermal/thermal_zone*/type | head -1 || true)
    [[ -n "$zone" ]] || { echo "Cannot read the CPU temperature: there is no x86_pkg_temp thermal zone."; exit 1; }
    t=$(( $(cat "${zone%/type}/temp") / 1000 ))
    echo "The CPU is at ${t}°C (alert from 90°C, it throttles at 100°C)."
    (( t < 90 ))
    ;;
docker)
    if systemctl is-active -q docker; then
        echo "Docker is running."
        exit 0
    fi
    echo "Docker is not running, so none of the services are up."
    exit 1
    ;;
unhealthy)
    # Docker's own healthcheck result, and the only signal here that catches a
    # service dying *inside* a container that stays up. otbr-agent crash-looped
    # for 18 days behind the s6 supervisor in its image: the container never
    # restarted, so `restarts` above could not see it - it greps the journal
    # for container starts - and `docker ps` said "Up" the entire time.
    #
    # Reports rather than acts. An unhealthy container may be mid-recovery,
    # and what fixed the last one was a restart someone chose to do after
    # looking. Each service defines its own probe in its own compose file,
    # which is where the knowledge of what "working" means belongs.
    unhealthy=() unprobed=() well=0
    while read -r name; do
        [[ -n "$name" ]] || continue
        state=$(docker inspect \
            -f '{{if .Config.Healthcheck}}{{.State.Health.Status}}{{else}}none{{end}}' \
            "$name" 2>/dev/null) || continue
        case "$state" in
            # starting = still inside its start_period, not yet a verdict.
            healthy|starting) well=$(( well + 1 )) ;;
            none)             unprobed+=("$name") ;;
            # The only other state Docker has is "unhealthy".
            *)                unhealthy+=("$name") ;;
        esac
    done < <(docker ps --format '{{.Names}}')

    # The first words matter: homelab-notify turns "<name> is failing" into
    # the title.
    if (( ${#unhealthy[@]} == 1 )); then
        echo "${unhealthy[0]} is failing its healthcheck. Its log: docker logs ${unhealthy[0]}"
        exit 1
    elif (( ${#unhealthy[@]} > 1 )); then
        echo "Failing their healthchecks: ${unhealthy[*]}. Logs: docker logs <name>"
        exit 1
    fi

    # A container with no probe is an unwatched service, worth saying out loud
    # without paging anyone: ad-hoc `docker run`s land here too.
    if (( ${#unprobed[@]} > 0 )); then
        echo "$well containers are healthy. Not watched, because they have no healthcheck: ${unprobed[*]}"
    else
        echo "All $well containers are healthy."
    fi
    exit 0
    ;;
backup)
    # The backup writes this stamp only after restic has finished and verified
    # the repository, so a stale stamp covers every way it can fail: no
    # network, wrong credentials, full bucket, a crash halfway through.
    #
    # The stamp lives on the SD card rather than /data, so this still answers
    # when /data is exactly what broke - which is when you most want to know
    # how old the backup is.
    STAMP=/var/lib/homelab/backup-stamp
    # 25-backup.sh keeps the timer off until the backup is set up.
    if ! systemctl is-enabled -q homelab-backup.timer; then
        echo "Backups are not set up yet - see modules/25-backup.sh."
        exit 0
    fi
    if systemctl is-failed -q homelab-backup.service; then
        echo "The last backup run failed. Details: journalctl -u homelab-backup"
        exit 1
    fi
    if [[ ! -f "$STAMP" ]]; then
        echo "No backup has ever completed."
        exit 1
    fi
    hours=$(( ( $(date +%s) - $(stat -c %Y "$STAMP") ) / 3600 ))
    # Nightly, plus up to 30min of RandomizedDelaySec: 36h means a night was
    # missed, not that one ran late.
    if (( hours < 36 )); then
        # The recovery message lands right after a run, so its age would
        # always read 0h - when it finished says more.
        echo "The last backup finished $(date -r "$STAMP" '+%a %d %b, %H:%M') and was verified."
        exit 0
    fi
    echo "No backup has finished for $hours hours - the last one was $(date -r "$STAMP" '+%a %d %b, %H:%M')."
    exit 1
    ;;
*)
    echo "usage: homelab-check data|restarts|kmem|temp|docker|unhealthy|backup" >&2
    exit 2
    ;;
esac
