[Unit]
Description=Reset the live system to the pristine baseline, if armed
# A cheap first pass on the arm marker, which lives on this system's own ESP
# (ESP-B). reset-main.sh re-checks it along with the other gates.
After=local-fs.target
ConditionPathExists=/boot/efi/homelab-reset.arm

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/homelab-reset-main
RemainAfterExit=yes
# Type=oneshot already disables the start timeout; stated explicitly because a
# rootfs rsync killed halfway leaves the live system unbootable.
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
